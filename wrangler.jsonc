{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fly-circuit-arena",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-12",
  "workers_dev": true,
  "assets": { "directory": "./dist", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": ["/api/*"] },
  "durable_objects": { "bindings": [{ "name": "ARENA", "class_name": "FlyArena" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["FlyArena"] }],
  "triggers": { "crons": ["*/5 * * * *"] },
  "observability": { "enabled": true, "head_sampling_rate": 0.1 }
}
